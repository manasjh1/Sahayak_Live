# ── PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_DB=shayak_waitlist
POSTGRES_USER=shayak
POSTGRES_PASSWORD=change_me_in_production   # ← REQUIRED: set a strong password

# ── Backend ──────────────────────────────────────────────────────────
# Full DB URL — constructed from above in docker-compose; set here only
# if running the backend outside Docker
DATABASE_URL=postgresql+asyncpg://shayak:change_me_in_production@db:5432/shayak_waitlist

# HIGH FIX: Admin API key — REQUIRED to access GET /api/waitlist routes
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change_me_to_a_random_secret_key

# CORS — comma-separated allowed origins; never use * in production
# Example: CORS_ORIGINS=https://shayak.ai,https://www.shayak.ai
CORS_ORIGINS=*

# Environment mode: development | production
# In production: docs disabled, HSTS enabled
ENV=development

# ── Ports ────────────────────────────────────────────────────────────
FRONTEND_PORT=80
BACKEND_PORT=8000
